#version 450
layout(local_size_x = 32, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba8) uniform image2D dst;
layout(push_constant) uniform Params {
    uint src_w;
    uint src_h;
    uint dst_w;
    uint dst_h;
    float inv_out_w; 
    float inv_out_h; 
    uint off_x;      
    uint off_y;
    uint out_w;      
    uint out_h;
} params;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (uint(p.x) >= params.dst_w || uint(p.y) >= params.dst_h) {
        return;
    }
    if (uint(p.x) < params.off_x || uint(p.y) < params.off_y
        || uint(p.x) >= params.off_x + params.out_w
        || uint(p.y) >= params.off_y + params.out_h) {
        imageStore(dst, p, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    vec2 uv = (vec2(float(p.x - int(params.off_x)), float(p.y - int(params.off_y))) + 0.5)
        * vec2(params.inv_out_w, params.inv_out_h);
    vec4 c = texture(src, clamp(uv, vec2(0.0), vec2(1.0)));
    imageStore(dst, p, c);
}