#version 450

layout(local_size_x = 32, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba8) uniform image2D dst;

layout(push_constant) uniform Params {
    uint src_w;
    uint src_h;
    uint dst_w;
    uint dst_h;
    float inv_out_w; // 1/fit_w: full source maps onto the fitted rect, not the whole dst
    float inv_out_h; // 1/fit_h
    uint off_x;      // fitted rect origin within dst (letterbox bars stay black)
    uint off_y;
    uint out_w;      // fitted rect size (aspect-preserving fit of src into dst)
    uint out_h;
} params;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (uint(p.x) >= params.dst_w || uint(p.y) >= params.dst_h) {
        return;
    }

    // Aspect-fit letterbox: pixels outside the fitted rect keep black bars
    // instead of stretching the image (which cropped the taskbar/tray and
    // distorted non-16:9 client resolutions).
    if (uint(p.x) < params.off_x || uint(p.y) < params.off_y
        || uint(p.x) >= params.off_x + params.out_w
        || uint(p.y) >= params.off_y + params.out_h) {
        imageStore(dst, p, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    // Sample with a half-texel offset so the filter is centered on texels.
    vec2 uv = (vec2(float(p.x - int(params.off_x)), float(p.y - int(params.off_y))) + 0.5)
        * vec2(params.inv_out_w, params.inv_out_h);

    vec4 c = texture(src, clamp(uv, vec2(0.0), vec2(1.0)));
    imageStore(dst, p, c);
}
